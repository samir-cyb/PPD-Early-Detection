# --- Python virtual environment (huge, machine-specific, never commit) ---
.venv/
venv/
env/
ENV/

# --- Python cache / bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# --- Jupyter ---
.ipynb_checkpoints/

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE ---
.vscode/
.idea/
*.swp

# --- Local environment / secrets (if any added later) ---
.env
*.env.local

# --- Temporary / backup files ---
*.tmp
*.bak
~$*
